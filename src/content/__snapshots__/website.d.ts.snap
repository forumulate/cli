    title?: string;
    description?: string;
    image?: {
      assetId: string;
      url: string;
      width?: number | null;
      height?: number | null;
      alt?: string;
      caption?: string | null;
      focal?: {
        x: number;
        y: number;
      } | null;
      blurDataURL?: string | null;
      /** A dominant colour to paint while the picture loads. */
      placeholder?: string | null;
      contentType?: string;
      variants?: Record<string, string>;
    } | null;
    noindex?: boolean;
    canonical?: string;
  };
  /** Layout */
  layout?: "default" | "wide" | "landing";
  /** A disabled route stops resolving without losing its entry or its history. */
  status?: "active" | "disabled";
};

