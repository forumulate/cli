/** Every block type, discriminated on `blockType`. */
export type Block = HeroBlock | TextBlock | FeaturesBlock | CtaBlock | ImageBlock;

export type BlockTypeKey = Block['blockType'];

/** Block types by key. */
export type Blocks = {
  hero: HeroBlock;
  text: TextBlock;
  features: FeaturesBlock;
  cta: CtaBlock;
  image: ImageBlock;
};

/** The fields of each collection (a content type with many entries), by key. */
export type ContentTypes = {
  route: RouteFields;
  page: PageFields;
  menu: MenuFields;
  post: PostFields;
};

/** The fields of each global (one entry per locale), by key. */
export type Globals = {
  site: SiteFields;
  header: HeaderFields;
  footer: FooterFields;
  strings: StringsFields;
};

/** The delivery envelope of each content type, by key. */
export type Entries = {
  route: RouteEntry;
  page: PageEntry;
  menu: MenuEntry;
  post: PostEntry;
  site: SiteEntry;
  header: HeaderEntry;
  footer: FooterEntry;
  strings: StringsEntry;
};

export type ContentTypeKey = keyof ContentTypes;

export type GlobalKey = keyof Globals;

/** Everything at once, for a client typed against this library. */
export type ForumulateContent = {
  types: ContentTypes;
  globals: Globals;
  blocks: Blocks;
  entries: Entries;
};
