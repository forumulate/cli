{
  "name": "@forumulate/cli",
  "version": "0.11.0",
  "description": "Command-line interface for Forumulate — manage orgs, spaces, docs, and search from your terminal.",
  "license": "MIT",
  "homepage": "https://forumulate.com/guides",
  "bugs": {
    "url": "https://forumulate.com/community"
  },
  "keywords": [
    "forumulate",
    "cli",
    "docs",
    "documentation",
    "publish",
    "static-site",
    "knowledge-base",
    "doctor"
  ],
  "bin": {
    "forumulate": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/slim-spec.mjs --copy",
    "slim-spec": "node scripts/slim-spec.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc-src.tsbuildinfo",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@forumulate/sdk": "^0.11.0",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "author": "Forumulate",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/forumulate/cli.git"
  }
}
